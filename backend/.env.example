# Port the API listens on
PORT=3001

# SMTP credentials (example shown for Gmail; use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password

# The "From" address shown on the email (often same as SMTP_USER)
MAIL_FROM=Avillanosa IT Solutions <your-gmail-address@gmail.com>

# Where inquiries are delivered
MAIL_TO=hello@itsavillanosa.com

# Comma-separated list of sites allowed to call this API
ALLOWED_ORIGINS=https://itsavillanosa.com,http://localhost:5173
